# ==========================================
# JobMatch AI v2.0 - Environment Configuration
# ==========================================

# GEMINI_API_KEY: Required for Gemini API calls.
# AI Studio automatically injects this at runtime or configure via Google AI Studio.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port.
PORT=3000

# GOOGLE OAUTH CREDENTIALS (For Gmail API sending option):
# Generated in Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# SESSION_SECRET: Used for session integrity and signing
SESSION_SECRET="your_random_session_secret_string"

# ENCRYPTION_KEY: 32-character key for AES-256-GCM token encryption at rest
ENCRYPTION_KEY="jobmatch_super_secure_key_32chars!"

# HUNTER_API_KEY: (Optional) For verifying recruiter email addresses via Hunter.io
HUNTER_API_KEY=""

# SAFETY LIMITS
DAILY_EMAIL_LIMIT="20"
DAILY_ANALYSIS_LIMIT="5"
